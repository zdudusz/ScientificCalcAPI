      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.24.1-preview.1" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ScientificCalc.Application\ScientificCalcApi.Application.csproj" />
    <ProjectReference Include="..\ScientificCalcAPI.core\ScientificCalcAPI.Core.csproj" />
    <ProjectReference Include="..\ScientificCalcApi.Shared\ScientificCalcApi.Shared.csproj" />
    <ProjectReference Include="..\ScientificCalculatorApi.Infraestructure\ScientificCalculatorApi.Infraestructure.csproj" />
  </ItemGroup>

